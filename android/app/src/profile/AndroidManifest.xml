<?xml version="1.0" encoding="utf-8"?>
<!--
    Profile build only. Each activity runs a synthetic profiling or validation workload on disposable data:
    S4-11 OutboxBurstActivity, S4-08 RestaurantCacheCheckActivity, S4-07 Bq10CheckActivity.
    Exported so `adb shell am start` can launch them; they never read or write the app's own data.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <activity
            android:name="com.campusmeal.android.profiling.OutboxBurstActivity"
            android:exported="true"
            android:theme="@android:style/Theme.DeviceDefault.Light.NoActionBar" />
        <activity
            android:name="com.campusmeal.android.profiling.RestaurantCacheCheckActivity"
            android:exported="true"
            android:theme="@android:style/Theme.DeviceDefault.Light.NoActionBar" />
        <activity
            android:name="com.campusmeal.android.profiling.Bq10CheckActivity"
            android:exported="true"
            android:theme="@android:style/Theme.DeviceDefault.Light.NoActionBar" />
    </application>

</manifest>